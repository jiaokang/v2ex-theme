{
  "name": "v2ex-theme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply v2ex-theme --local",
    "db:migrate:remote": "wrangler d1 migrations apply v2ex-theme --remote",
    "screenshots:themes": "node scripts/capture-theme-previews.mjs"
  },
  "dependencies": {
    "@botiverse/raft-ui": "^0.102.18",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@ui-sdk/core": "^0.1.0-beta.13",
    "@ui-sdk/react": "^0.1.0-beta.13",
    "lucide-react": "^1.77.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
